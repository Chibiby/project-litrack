{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "project-litrack",
  // Pinned to the pixelonhub account (since 2026-11-08). A Workers Builds run
  // connected in any other account, such as the old one, then fails at deploy
  // instead of shipping production there.
  "account_id": "f422363ac391253c19295a240adbd9c7",
  // Wraps `.open-next/worker.js` so the Worker also answers Cron Triggers.
  // See worker.js — the cron expressions below must match its CRON_ROUTES map.
  "main": "worker.js",
  "compatibility_date": "2026-09-12",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  // Run the Worker next to the database. Supabase is in AWS ap-southeast-1
  // (Singapore); a page makes many Postgres round trips, so running at the
  // edge location nearest each user put the full user→Singapore distance into
  // every query. This is the Cloudflare equivalent of the old Vercel `sin1` pin.
  "placement": {
    "mode": "targeted",
    "region": "aws:ap-southeast-1"
  },
  // Next Data Cache backing for open-next.config.ts. Entries in KV, tag
  // revalidations in D1 (table `revalidations`).
  "kv_namespaces": [
    {
      "binding": "NEXT_INC_CACHE_KV",
      "id": "7e5a9233e3c04717bb817ec177b2e679"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "litrack-tag-cache",
      "database_id": "5e44542a-ed74-48d2-9532-b33fa28e56fd"
    },
    // Shared login and action throttle (src/lib/rate-limit-d1.ts), table rl_hits.
    {
      "binding": "RATE_LIMIT_D1",
      "database_name": "litrack-rate-limit",
      "database_id": "e84d6fdb-bc4c-4f0c-8b7b-560a13637767"
    }
  ],
  // Profile photos. Written only through src/lib/storage/avatar-objects.ts;
  // read publicly at https://avatars.arallitrack.com (the bucket custom
  // domain), which next.config.mjs inlines as NEXT_PUBLIC_AVATAR_BASE_URL.
  "r2_buckets": [
    {
      "binding": "AVATARS",
      "bucket_name": "litrack-avatars"
    },
    // Private database backups (src/lib/db/backup-store-r2.ts). No public
    // domain: downloads go through /api/admin/backups/download.
    {
      "binding": "BACKUPS",
      "bucket_name": "litrack-backups"
    }
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "b43ecd7c83054f2dacd45f19e6f0d795",
      // Local-only placeholder, same reason as HYPERDRIVE_FRESH below, so the
      // build needs no CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_* variable.
      "localConnectionString": "postgresql://unconfigured:unconfigured@127.0.0.1:1/unconfigured"
    },
    // litrack-neon-fresh: same database, query caching DISABLED, origin is
    // Neon's direct host. Read through `prismaFresh` only, by the School
    // Head teachers workspace, which must show a save the moment it lands —
    // the cached binding above can return rows about a minute old.
    {
      "binding": "HYPERDRIVE_FRESH",
      "id": "76cfa620a26f4b74969b1e90abc86cc6",
      // Local-only placeholder, never used in production. `opennextjs-cloudflare
      // deploy` starts a local platform proxy that needs a local connection
      // string for EVERY Hyperdrive binding; the Workers Builds env var only
      // covers HYPERDRIVE, so without this the deploy step fails. A closed
      // localhost port, same as UNCONFIGURED_DATABASE_URL in src/lib/prisma.ts.
      "localConnectionString": "postgresql://unconfigured:unconfigured@127.0.0.1:1/unconfigured"
    }
  ],
  // Headroom for the nightly snapshot, which reads every table and gzips it.
  // 5 minutes is the ceiling on Workers Paid; this is a CPU budget, not wall
  // clock, so time waiting on Postgres does not count against it.
  //
  // Note for whoever reads this next: raising this did NOT fix the backup. The
  // 1102 that failure returns is `exceededMemory`, not CPU — the snapshot
  // materialises the whole dataset in a 128 MB isolate. The setting is kept
  // because a streaming snapshot will still be a long-running job, not because
  // it solved anything.
  "limits": {
    "cpu_ms": 30000
  },
  // Replaces the `crons` block in vercel.json. Times are UTC; Manila is UTC+8.
  // "*/5 * * * *" fires every 5 minutes, but it only re-warms the Division Summary
  // cache after a deploy, a summary reset, or once a day.
  "triggers": {
    "crons": ["0 16 * * *", "30 16 * * 6", "*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
