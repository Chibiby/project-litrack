# --- Database (Supabase Postgres) ---
# Pooled connection for the app (Prisma Client at runtime). Prefer port 6543 + pgbouncer=true.
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Direct / session connection for migrations (port 5432). Optional for app runtime.
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[ANON-KEY]"
# Required for admin Auth APIs (create users, invites). Optional at boot; warn if missing.
SUPABASE_SERVICE_ROLE_KEY="[SERVICE-ROLE-KEY]"

# --- Email (Resend) ---
# Optional; without these, invite emails no-op / log the link in development.
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="LITRACK <noreply@yourdomain.com>"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Domain used for School Head synthetic login emails (default: litrack.local).
SYNTHETIC_EMAIL_DOMAIN="litrack.local"

# --- Super Admin Bootstrap (used by prisma/seed.ts only) ---
SEED_SUPER_ADMIN_EMAIL="admin@litrack.local"
SEED_SUPER_ADMIN_PASSWORD="ChangeMe123!"
