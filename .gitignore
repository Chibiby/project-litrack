.env*

# Scratch dist dir for verification builds run alongside `next dev`
.next-verify/
.open-next/
.wrangler-dry-run/
# Wrangler's own build/state directory. Untracked but previously not ignored,
# so a `git add .` would have committed local build state.
.wrangler/

# Impeccable design review captures (local evidence, not source)
.impeccable/review/

# Per-machine agent tooling, not project source. `.claude/agents/` and the one
# committed skill are shared and stay tracked; everything else under here is
# whatever this particular machine happens to have installed, and `worktrees/`
# holds live git worktrees that must never be committed at all.
.claude/worktrees/
.claude/skills/*
!.claude/skills/orchestrator/
.agents/
skills-lock.json

# TypeScript incremental build cache (per-machine, regenerated by every build)
*.tsbuildinfo

# Local session artifacts, not source
screenshots/
skill-observations/
skill-updates/

.env.migrate

# Local Playwright sessions (e2e/auth/*.mjs)
e2e/.auth/
