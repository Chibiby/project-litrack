// PROJECT LITRACK - Prisma Schema
// Datasource: Supabase Postgres

generator client {
  provider        = "prisma-client-js"
  // Nested select/include otherwise costs one round trip per relation. With this
  // on, `relationLoadStrategy: "join"` makes the engine emit a single LATERAL
  // join instead. Read sites opt in explicitly rather than relying on the
  // default. Kill switch per environment: PRISMA_RELATION_LOAD_STRATEGY.
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  SUPER_ADMIN
  SCHOOL_HEAD
  TEACHER
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GradeLevelType {
  KINDER
  G1
  G2
  G3
  G4
  G5
  G6
  G7
  G8
  G9
  G10
  G11
  G12
  FLOATING
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ReadingProfile {
  NON_DECODER_LOW_EMERGENT
  FRUSTRATION_HIGH_EMERGENT
  INSTRUCTIONAL_DEVELOPING
  INDEPENDENT_GRADE_READY
}

// Weekly ARAL word-recognition level (not AralProfile.wordRecognition).
enum WeeklyWordRecognitionLevel {
  LEVEL_1
  LEVEL_2
  LEVEL_3
  LEVEL_4
  LEVEL_5
  LEVEL_0
  NA
}

// Weekly ARAL writing level. Deliberately rubric-neutral: UI labels live in
