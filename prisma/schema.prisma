enum ParentalSupport {
  REGULAR
  LIMITED
  NONE
  NA
}

enum ClassroomEnvironment {
  SMALL_CLASS
  LARGE_CLASS
  NA
}

enum LanguageConsideration {
  MATCHES_LOI
  DIFFERENT_DIALECT
  STRUGGLES_TRANSITION
  NA
}

enum Intervention {
  PHONEMIC_AWARENESS
  LETTER_SOUND_DRILLS
  SIGHT_WORD_PRACTICE
  STRUCTURED_PHONICS
  ONE_ON_ONE
  HOME_READING
  LSEN_OTHER
}

enum FurtherAssessment {
  MFAT
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  ARCHIVED
}

enum NotificationType {
  /// A teacher was designated as the ARAL tutor for one or more learners by
  /// somebody else.
  ARAL_ASSIGNED
}

/// The three grading terms. The calendar window each term covers is DERIVED from
/// the active `SchoolYear.startDate`, never stored, so a school starting in June
/// and one starting in August both get correct windows with no extra rows.
enum TermPeriod {
  FIRST
  SECOND
  THIRD
}

/// Learning areas on the term grade sheet.
///
/// Deliberately NOT the `Subject` enum: that one is a dead teacher-survey
/// artifact (`ARALPAN`, `ABM`, `TECHVOC`) kept only for existing profile rows,
/// and a live feature must not depend on a set that is scheduled for removal.
enum LearningArea {
  ENGLISH
  FILIPINO
  MATHEMATICS
  SCIENCE
  ARALING_PANLIPUNAN
  EDUKASYON_SA_PAGPAPAKATAO
  MAPEH
  TLE
}

// =====================================================
// MODELS
// =====================================================

model School {
  id           String    @id @default(uuid())
  name         String    @unique
  schoolIdCode String    @unique // password used for login
  address      String?
  region       String?
  division     String?
  district     String?
  isActive     Boolean   @default(true)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users          User[]
  gradeLevels    GradeLevel[]
  learners       Learner[]
  schoolYears    SchoolYear[]
  teacherInvites TeacherInvite[]
  sections       Section[]
  enrollments    Enrollment[]
  announcements  Announcement[]
  notifications  Notification[]

  @@index([deletedAt])
  @@index([isActive])
}

model SchoolYear {
  id        String   @id @default(uuid())
  schoolId  String
  label     String // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]
  termGrades  TermGrade[]

  @@unique([schoolId, label])
  @@index([schoolId, isActive])
}

model User {
  id                 String                 @id @default(uuid())
  authId             String                 @unique // Supabase auth.users.id
  email              String                 @unique
  role               UserRole
  schoolId           String?
  firstName          String
  middleName         String?
  lastName           String
  fullName           String
  isActive           Boolean                @default(false)
  mustChangePassword Boolean                @default(false)
  // Profile completion flags
  profileCompleted   Boolean                @default(false)
  // Teacher self-registration approval (null for non-teacher roles)
  approvalStatus     TeacherApprovalStatus?
  approvedAt         DateTime?
  approvedById       String?
  rejectedAt         DateTime?
  /// Advisory assignment: 0 or 1 section per teacher. Grade is DERIVED from the
  /// section, never stored here. @unique enforces one adviser per section.
  advisorySectionId  String?                @unique
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  deletedAt          DateTime?

  school                 School?              @relation(fields: [schoolId], references: [id])
  schoolHeadProfile      SchoolHeadProfile?
  teacherProfile         TeacherProfile?
  advisorySection        Section?             @relation("SectionAdviser", fields: [advisorySectionId], references: [id], onDelete: SetNull)
  taughtGrades           GradeLevel[]         @relation("TeacherGrades")
  taughtSections         TeacherSection[]
  managedLearners        Learner[]            @relation("TeacherLearners")
  aralLearners           Learner[]            @relation("AralTeacherLearners")
  recordedAttendance     Attendance[]         @relation("AttendanceRecorder")
  recordedReadingLevels  ReadingLevelRecord[] @relation("ReadingRecorder")
  recordedTermGrades     TermGrade[]          @relation("TermGradeRecorder")
  recordedAttendanceDays AttendanceDayMeta[]  @relation("AttendanceDayRecorder")
  teacherEnrollments     Enrollment[]         @relation("TeacherEnrollments")
  announcements          Announcement[]
  teacherInvites         TeacherInvite[]      @relation("TeacherInviteUser")
  notifications          Notification[]       @relation("NotificationRecipient")
  notificationsCaused    Notification[]       @relation("NotificationActor")

  @@index([schoolId, role, deletedAt])
  @@index([schoolId, approvalStatus])
  @@index([authId])
}

model SchoolHeadProfile {
  id     String @id @default(uuid())
  userId String @unique

  // I. Respondent Information
  contactNumber String?
  /// Survey contact email (DOCX P-I4). Distinct from User.email login/synthetic identity.
  contactEmail  String?
  designation   String?
  position      SchoolHeadPosition

  // II. Professional Background
  educationalAttainment EducationalAttainment
  fieldOfSpecialization Specialization
  specializationOther   String?
  /// Years in service (0–70 inclusive).
  yearsInService        Int

  // IV. Training & Professional Development
  hasReadingTraining   Boolean
  readingTrainings     ReadingTraining[]
  hasEnglishTraining   Boolean
  englishTrainings     EnglishTraining[]
  highestTrainingLevel TrainingLevel

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique

  // I. Respondent Information
  contactNumber  String?
  /// Survey contact email (DOCX P-I4). Distinct from User.email login/synthetic identity.
  contactEmail   String?
  designation    String?
  position       TeacherPosition?
  /// DepEd plantilla or not. Nullable because every profile completed before this
  /// field existed never answered the question, and a default would make those
  /// rows claim an answer nobody gave.
  ///
  /// DISPLAY ONLY. It is shown as a chip when designating an ARAL tutor so the
  /// person choosing can see who they are picking. It must never narrow the list
  /// of eligible tutors — a non-DepEd teacher is a valid ARAL tutor, which is the
  /// whole reason the field exists.
  employmentType EmploymentType?

  // II. Professional Background
  educationalAttainment  EducationalAttainment
  fieldOfSpecialization  Specialization
  specializationOther    String?
  /// Years in service (0–70 inclusive). Null = N/A (teacher declined to specify).
  yearsInService         Int?
  currentGradeAssignment GradeLevelType?

  // III. Teaching Assignment
  /// Unused by the app going forward (removed from UI); kept nullable rather than
  /// dropped per "additive first" — drop in a future wave once explicitly approved.
  mostSubjectHandled Subject?

  // IV. Training & Professional Development
  hasReadingTraining   Boolean
  readingTrainings     ReadingTraining[]
  hasEnglishTraining   Boolean
  englishTrainings     EnglishTraining[]
  highestTrainingLevel TrainingLevel

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherInvite {
  id             String    @id @default(uuid())
  schoolId       String
  email          String? // optional — DOCX flow may add teachers by full name only
  firstName      String
  middleName     String?
  lastName       String
  userId         String? // teacher User created at invite time
  gradeLevelId   String?
  sectionId      String?
  tokenHash      String    @unique
  credentialHash String? // SHA-256 of one-time activation credential
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?       @relation("TeacherInviteUser", fields: [userId], references: [id], onDelete: SetNull)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([schoolId, email])
  @@index([userId])
  @@index([expiresAt])
}

model GradeLevel {
  id        String         @id @default(uuid())
  schoolId  String
  type      GradeLevelType
  createdAt DateTime       @default(now())
  deletedAt DateTime?

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers       User[]              @relation("TeacherGrades")
  learners       Learner[]
  sections       Section[]
  enrollments    Enrollment[]
  teacherInvites TeacherInvite[]
  attendanceDays AttendanceDayMeta[]

  @@unique([schoolId, type])
  @@index([deletedAt])
}

model Section {
  id           String    @id @default(uuid())
  schoolId     String
  gradeLevelId String
  name         String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel     GradeLevel       @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  adviser        User?            @relation("SectionAdviser")
  teachers       TeacherSection[]
  learners       Learner[]
  enrollments    Enrollment[]
  teacherInvites TeacherInvite[]

  @@unique([gradeLevelId, name])
  @@index([schoolId, deletedAt])
}

/// Explicit M2M: which sections a teacher is assigned to teach.
/// Dual-written with `User.taughtGrades` during the Grade→Section migration.
model TeacherSection {
  teacherId  String
  sectionId  String
  assignedAt DateTime @default(now())

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([teacherId, sectionId])
  @@index([sectionId])
}

model Enrollment {
  id           String           @id @default(uuid())
  learnerId    String
  schoolId     String
  schoolYearId String
  gradeLevelId String
  sectionId    String?
  teacherId    String?
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  endedAt      DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  section    Section?   @relation(fields: [sectionId], references: [id])
  teacher    User?      @relation("TeacherEnrollments", fields: [teacherId], references: [id])

  @@index([learnerId, status])
  @@index([schoolId, schoolYearId])
  @@index([teacherId])
  @@index([gradeLevelId, sectionId])
}

model Learner {
  id            String  @id @default(uuid())
  schoolId      String
  gradeLevelId  String
  /// Adviser. Null for a floating learner (no advisory section yet).
  teacherId     String?
  sectionId     String?
  /// ARAL designation, independent of the advisory axis. May point at a teacher
  /// with no advisory section.
  aralTeacherId String?

  // Section A - Initial Profile
  firstName  String
  middleName String?
  lastName   String
  fullName   String
  age        Int
  gender     Gender

  // Nullable: learners rostered before ethnicity was collected have none.
  ethnicity      Ethnicity?
  // Free text only when ethnicity = OTHER.
  ethnicityOther String?

  englishReadingProfile       ReadingProfile
  englishFrustrationSubtypes  FrustrationSubtype[]
  filipinoReadingProfile      ReadingProfile
  filipinoFrustrationSubtypes FrustrationSubtype[]

  governmentBenefits GovernmentBenefit[]
  parentEducation    ParentEducation

  // Section B - Attendance & School Background
  modeOfTransportation ModeOfTransportation?
  distanceHomeToSchool DistanceToSchool?
  previousTransfers    SchoolTransfers?
  transferDetails      String?

  // ARAL flag
  isAralLearner  Boolean   @default(false)
  aralEnrolledAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime? // archive is distinct from soft-delete deletedAt

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel    GradeLevel           @relation(fields: [gradeLevelId], references: [id])
  teacher       User?                @relation("TeacherLearners", fields: [teacherId], references: [id], onDelete: Restrict)
  aralTeacher   User?                @relation("AralTeacherLearners", fields: [aralTeacherId], references: [id], onDelete: SetNull)
  section       Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  aralProfile   AralProfile?
  attendances   Attendance[]
  readingLevels ReadingLevelRecord[]
  termGrades    TermGrade[]

  @@index([schoolId, gradeLevelId, isAralLearner, deletedAt])
  @@index([teacherId])
  @@index([aralTeacherId])
  @@index([schoolId, aralTeacherId, isAralLearner, deletedAt])
}

model Announcement {
  id          String    @id @default(uuid())
  schoolId    String
  authorId    String
  title       String
  body        String
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId, publishedAt])
  @@index([deletedAt])
}

model AralProfile {
  id        String @id @default(uuid())
  learnerId String @unique

  // C. Reading Behavior
  absenteeismFrequency      AbsenteeismFrequency
  absenteeismOtherReason    String?
  letterRecognition         LetterRecognition
  letterSoundCorrespondence LetterSoundCorrespondence
  wordRecognition           WordRecognition

  // D. External Factors
  homeLiteracyEnvironment HomeLiteracyEnvironment
  parentalSupport         ParentalSupport
  classroomEnvironment    ClassroomEnvironment
  languageConsiderations  LanguageConsideration[]

  // E. Interventions & Recommendations
  suggestedInterventions Intervention[]
  lsenObservations       String?
  furtherAssessment      FurtherAssessment[]
  furtherAssessmentOther String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String           @id @default(uuid())
  learnerId    String
  date         DateTime         @db.Date
  weekStart    DateTime         @db.Date // Monday of that week, for aggregation
  status       AttendanceStatus
  notes        String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([learnerId, date])
  @@index([learnerId, weekStart])
  @@index([date])
}

/// Grade-level day metadata (e.g. holiday) for ARAL attendance grids.
model AttendanceDayMeta {
  id           String   @id @default(uuid())
  gradeLevelId String
  date         DateTime @db.Date
  isHoliday    Boolean  @default(false)
  recordedById String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("AttendanceDayRecorder", fields: [recordedById], references: [id])

  @@unique([gradeLevelId, date])
  @@index([date])
}

model ReadingLevelRecord {
  id                        String                           @id @default(uuid())
  learnerId                 String
  weekStart                 DateTime                         @db.Date // Monday of the recorded week
  englishProfile            ReadingProfile
  filipinoProfile           ReadingProfile
  wordRecognitionLevel      WeeklyWordRecognitionLevel?
  readingComprehensionLevel WeeklyReadingComprehensionLevel?
  writingLevel              WeeklyWritingLevel?
  notes                     String?
  recordedById              String
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("ReadingRecorder", fields: [recordedById], references: [id])

  @@unique([learnerId, weekStart])
  @@index([weekStart])
}

/// One learner's grade in one learning area for one term of one school year.
/// Corrected by overwrite, never soft-deleted - hence no `deletedAt`.
model TermGrade {
  id           String       @id @default(uuid())
  learnerId    String
  schoolYearId String
  term         TermPeriod
  subject      LearningArea
  score        Int // 60-100, enforced by a CHECK constraint in SQL
  recordedById String
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  recordedBy User       @relation("TermGradeRecorder", fields: [recordedById], references: [id])

  @@unique([learnerId, schoolYearId, term, subject])
  @@index([schoolYearId, term])
}

/// An in-app message addressed to one user, with its own read state.
///
/// The shell bell previously rendered values DERIVED from dashboard numbers, which
/// cannot carry "who did this to me" or "I have seen it". Both are required for an
/// ARAL designation, so designations get a row.
model Notification {
  id          String           @id @default(uuid())
  schoolId    String
  recipientId String
  /// Who caused it. Nullable so removing an account leaves the notification
  /// readable rather than deleting the recipient's history with it.
  actorId     String?
  type        NotificationType
  /// Learner ids this notification is about. Ids only: the sentence the recipient
  /// reads is composed at read time from the current learner rows, so no learner
  /// PII is duplicated into this table and a renamed or removed learner cannot
  /// leave stale text in the feed.
  ///
  /// One row per action, not per learner — enrolling twelve learners at once
  /// notifies the tutor once.
  learnerIds  String[]
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient User   @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor     User?  @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  /// The feed read: this recipient's unread rows, newest first.
  @@index([recipientId, readAt, createdAt])
  @@index([schoolId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  schoolId   String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([schoolId, timestamp])
  @@index([resource, resourceId])
}
