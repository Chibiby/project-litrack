// =====================================================
// MODELS
// =====================================================

model School {
  id           String    @id @default(uuid())
  /// Unique case-insensitively, via the SQL-only functional index
  /// `School_name_folded_key` on `lower(btrim(name))`. Prisma's schema language
  /// cannot express a functional unique — the same reason `schoolIdCode` below
  /// and `Enrollment`'s one-ACTIVE-row index live in SQL. Preserve it when
  /// editing School migrations. Stored casing is whatever the admin typed.
  name         String
  /// The six-digit DepEd School ID, and the School Head's first-login password.
  ///
  /// Unique among REAL schools only. The uniqueness is a partial index living in
  /// SQL (`School_schoolIdCode_real_key ... WHERE "isDemo" = false`), because
  /// Prisma's schema language cannot express a filtered unique — the same reason
  /// `Enrollment`'s one-ACTIVE-row-per-learner index is SQL-only. Preserve it
  /// when editing School migrations.
  ///
  /// The demo tenant is deliberately exempt so it can carry 123456 even when a
  /// real school already does. Nothing resolves a school BY this column — login
  /// takes a school UUID and every other reader is a `contains` search — so a
  /// shared value cannot misroute anyone.
  schoolIdCode String
  address      String?
  region       String?
  division     String?
  district     String?
  isActive     Boolean   @default(true)
  /// Marks the single training/demonstration tenant — the demo district, the
  /// demo school, its School Head and everything created under them. Real DepEd
  /// schools are never flagged. When `demo.enabled` in SystemSetting is off,
  /// every public and aggregate read filters these rows out; the rows themselves
  /// are untouched, so switching demo mode back on restores them exactly as they
  /// were. See src/lib/demo/constants.ts.
  isDemo       Boolean   @default(false)
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  users               User[]
  gradeLevels         GradeLevel[]
  learners            Learner[]
  schoolYears         SchoolYear[]
  teacherInvites      TeacherInvite[]
  sections            Section[]
  enrollments         Enrollment[]
  announcements       Announcement[]
  notifications       Notification[]
  reports             Report[]
  supportTickets      SupportTicket[]
  unlockGrants        UnlockGrant[]
  schoolUnlockGrants  SchoolUnlockGrant[]
  chatChannels        ChatChannel[]
  termWindowOverrides TermWindowOverride[]

  @@index([deletedAt])
  @@index([isActive])
  @@index([isDemo])
}

/// Global, tenant-less key/value configuration owned by the Super Admin.
/// Deliberately untyped: these are a handful of operator switches, not domain
/// data, and adding a switch should not cost a migration. Every reader parses
/// its own key (src/lib/settings/system-settings.ts) and must tolerate a missing
/// row by falling back to a documented default.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model SchoolYear {
  id        String   @id @default(uuid())
  schoolId  String
  label     String // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school              School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments         Enrollment[]
  termGrades          TermGrade[]
  termWindowOverrides TermWindowOverride[]

  @@unique([schoolId, label])
  @@index([schoolId, isActive])
}

/// A School Head's edit to one term of one school year.
///
/// A row exists ONLY where a head has actually changed something. Every
/// un-edited term stays derived by `getTermWindows`, which is why this needed no
/// backfill: a school that never opens the terms page behaves exactly as it did
/// before this table existed.
model TermWindowOverride {
  id           String     @id @default(uuid())
  /// Denormalised from `schoolYear.schoolId` so tenant scoping is a direct
  /// `where` clause like every other table here, rather than a join a caller
  /// might forget. Kept honest by the action, which reads the year first.
  schoolId     String
  schoolYearId String
  term         TermPeriod

  /// Local `YYYY-MM-DD`. Deliberately String, not DateTime.
  ///
  /// `SchoolYear.startDate` is a bare timestamp, so a year starting August 1 in
  /// Manila is stored as `2026-07-31T16:00:00Z` and reading its UTC month puts
  /// Term 1 in July — the hazard `src/lib/terms/windows.ts:66` documents at
  /// length. `TermWindow` already carries these as keys and `isTermLocked`
  /// already compares them as strings, so storing keys keeps ONE representation
  /// from column to comparison to screen, which no timezone can shift.
  startKey String
  endKey   String

  /// Last day grades may still be encoded. Equals `endKey` when a head edits
  /// only the months. Moving this is how a term is extended WITHOUT shifting the
  /// next term's months — the case the feature exists for.
  deadlineKey String

  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule. The
  /// window this row defines is unaffected by losing the name of who set it.
  setById   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school     School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  setBy      User?      @relation("TermWindowSetter", fields: [setById], references: [id], onDelete: SetNull)

  /// One override per term per year. A re-edit updates this row rather than
  /// stacking a second one, so "what is this term's window?" never depends on
  /// row order — the same reasoning as `UnlockGrant`'s unique.
  @@unique([schoolYearId, term])
  @@index([schoolId])
  /// R6. FK lookup side — now the side `SetNull` scans on a `User` delete.
  @@index([setById])
}

model User {
  id                        String                 @id @default(uuid())
  authId                    String                 @unique // Supabase auth.users.id
  email                     String                 @unique
  /// Login handle for the Super Admin console (`/admin/login`), which signs in
  /// by username rather than email. Nullable because School Heads sign in with
  /// school + password and teachers with school + email, so neither has one.
  /// Unique so two accounts can never claim the same handle.
  ///
  /// This is a login handle ONLY. `email` remains the account's identity for
  /// Supabase Auth and for password recovery: `loginAdmin` resolves
  /// username -> row -> `email` and hands that address to Supabase, and the
  /// forgot-password flow never reads this column.
  username                  String?                @unique
  role                      UserRole
  schoolId                  String?
  firstName                 String
  middleName                String?
  lastName                  String
  fullName                  String
  isActive                  Boolean                @default(false)
  mustChangePassword        Boolean                @default(false)
  /// True while the account's live Supabase password IS the school's
  /// `schoolIdCode` — set at school creation and by the Super Admin
  /// "reset to default" action, cleared the moment the password becomes
  /// anything else (user-chosen, or a random activation credential).
  ///
  /// This flag is what lets the Super Admin console display a working sign-in
  /// credential without ever storing a plaintext password: the only credential
  /// it can show is one the system itself chose and already has on record
  /// (`School.schoolIdCode`). A user's own password is a bcrypt hash inside
  /// Supabase Auth and is never readable — by design.
  passwordIsSchoolId        Boolean                @default(false)
  /// The account's own password, sealed with AES-256-GCM, so the Super Admin
  /// console can show a School Head the credential they actually chose instead
  /// of telling the admin to reset it out from under them.
  ///
  /// Written ONLY for `SCHOOL_HEAD` rows, and only by the three paths where the
  /// person types a password themselves (set-password, change-password,
  /// recovery). Teachers and Super Admins are never sealed — nothing displays
  /// them, so storing them would be exposure with no purpose. Cleared whenever
  /// the password becomes the School ID again, because `passwordIsSchoolId`
  /// already covers that case and a stale blob would show a dead credential.
  ///
  /// Format and key handling live in `src/lib/auth/password-vault.ts`. This is
  /// reversible by anyone holding the key plus this column, which is the point
  /// and also the cost — see `docs/privacy.md`.
  passwordVaultCipher       String?
  /// When `passwordVaultCipher` was last written. Shown to the admin so a
  /// revealed password carries its own age, and lets an operator find accounts
  /// sealed under a key that has since rotated.
  passwordVaultSetAt        DateTime?
  // Profile completion flags
  profileCompleted          Boolean                @default(false)
  /// Ticked the "I am a Non-DepEd ARAL Volunteer" box during self-registration.
  ///
  /// The declaration has to land somewhere before `TeacherProfile` exists: that
  /// row is only written when profiling is submitted, and its required columns
  /// make a stub impossible. So the intent is held here and read once, to seed
  /// and lock `TeacherProfile.designation` in the profiling wizard.
  ///
  /// NOT the authority on who is a volunteer — `TeacherProfile.designation` is
  /// (see `isAralVolunteerDesignation`). This only records what the person said
  /// at sign-up, which Settings -> Profile can later contradict.
  registeredAsAralVolunteer Boolean                @default(false)
  // Teacher self-registration approval (null for non-teacher roles)
  approvalStatus            TeacherApprovalStatus?
  approvedAt                DateTime?
  approvedById              String?
  rejectedAt                DateTime?
  /// LEGACY advisory pointer. Wave A of the multi-advisory change moved the
  /// authoritative assignment to `Section.adviserId`; this column is still
  /// DUAL-WRITTEN (holding the first of a teacher's sections) and is READ BY
  /// NOTHING for access. Wave B drops it, separately approved.
  ///
  /// It keeps its `@unique`: while it is written at all, two teachers must not
  /// name the same section here. That index is no longer what limits a teacher
  /// to one section — see `Section.adviserId` — it only stops the dying mirror
  /// from recording something the authoritative column would refuse.
  ///
  /// It carries NO `@relation` any more, deliberately. Inverting the pointer put
  /// a foreign key on `Section` pointing at `User`, and keeping one here pointing
  /// back would make the two models a cycle that no single write order can
  /// satisfy — `tests/unit/db/schema-order.test.ts` catches exactly that. So this
  /// becomes a plain nullable column, the same shape `School.createdById` and
  /// `AuditLog.userId` already have and for the same reason. Nothing reads it,
  /// so a stale id after a section is deleted costs nothing; Wave B removes it.
  advisorySectionId         String?                @unique
  /// The release version this user acknowledged, or null for one who has
  /// acknowledged none. A version string rather than a boolean or a timestamp on
  /// purpose: it survives a rollback (someone who saw 1.1.0 and is then served
  /// 1.0.9 is not re-interrupted) and it records WHICH release they saw, which a
  /// boolean cannot. Written on acknowledgement, never on display.
  lastSeenReleaseVersion    String?
  createdAt                 DateTime               @default(now())
  updatedAt                 DateTime               @updatedAt
  deletedAt                 DateTime?

  school                    School?              @relation(fields: [schoolId], references: [id])
  schoolHeadProfile         SchoolHeadProfile?
  teacherProfile            TeacherProfile?
  /// Authoritative. The sections this teacher advises — up to three, and the cap
  /// is enforced in `setTeacherAdvisory`, not in SQL, so the number can change
  /// without a migration. Deliberately renamed from `advisorySection`: every
  /// read site that assumed at most one now fails to compile rather than
  /// silently rendering the first of several.
  advisorySections          Section[]            @relation("SectionAdviser")
  taughtGrades              GradeLevel[]         @relation("TeacherGrades")
  taughtSections            TeacherSection[]
  managedLearners           Learner[]            @relation("TeacherLearners")
  aralLearners              Learner[]            @relation("AralTeacherLearners")
  recordedAttendance        Attendance[]         @relation("AttendanceRecorder")
  recordedReadingLevels     ReadingLevelRecord[] @relation("ReadingRecorder")
  recordedTermGrades        TermGrade[]          @relation("TermGradeRecorder")
  recordedAttendanceDays    AttendanceDayMeta[]  @relation("AttendanceDayRecorder")
  teacherEnrollments        Enrollment[]         @relation("TeacherEnrollments")
  announcements             Announcement[]
  teacherInvites            TeacherInvite[]      @relation("TeacherInviteUser")
  notifications             Notification[]       @relation("NotificationRecipient")
  notificationsCaused       Notification[]       @relation("NotificationActor")
  reports                   Report[]             @relation("ReportCreator")
  chatChannels              ChatChannel[]        @relation("ChatChannelMember")
  chatMessages              ChatMessage[]        @relation("ChatMessageAuthor")
  chatMentions              ChatMention[]        @relation("ChatMentionUser")
  chatReads                 ChatRead[]           @relation("ChatReadUser")
  supportTickets            SupportTicket[]      @relation("SupportTicketRequester")
  supportTicketsResolved    SupportTicket[]      @relation("SupportTicketResolver")
  unlockGrants              UnlockGrant[]        @relation("UnlockGrantUser")
  unlockGrantsIssued        UnlockGrant[]        @relation("UnlockGrantGranter")
  unlockGrantsRevoked       UnlockGrant[]        @relation("UnlockGrantRevoker")
  schoolUnlockGrantsIssued  SchoolUnlockGrant[]  @relation("SchoolUnlockGrantGranter")
  schoolUnlockGrantsRevoked SchoolUnlockGrant[]  @relation("SchoolUnlockGrantRevoker")
  termWindowOverridesSet    TermWindowOverride[] @relation("TermWindowSetter")

  @@index([schoolId, role, deletedAt])
  @@index([schoolId, approvalStatus])
  @@index([authId])
  /// The global `/admin/archive` read: `deletedAt IS NOT NULL ORDER BY deletedAt
  /// DESC`, cross-tenant and uncached. `[schoolId, role, deletedAt]` cannot serve
  /// it — that query supplies no `schoolId`, so `deletedAt` is never a usable
  /// leading column there. Same reasoning as `Learner`'s twin of this index.
  @@index([deletedAt])
}

model SchoolHeadProfile {
  id     String @id @default(uuid())
  userId String @unique

  // I. Respondent Information
  contactNumber String?
  /// Survey contact email (DOCX P-I4). Distinct from User.email login/synthetic identity.
  contactEmail  String?
  designation   String?
  position      SchoolHeadPosition

  // II. Professional Background
  educationalAttainment EducationalAttainment
  fieldOfSpecialization Specialization
  specializationOther   String?
  /// Years in service (0–70 inclusive).
  yearsInService        Int

  // IV. Training & Professional Development
  hasReadingTraining   Boolean
  readingTrainings     ReadingTraining[]
  hasEnglishTraining   Boolean
  englishTrainings     EnglishTraining[]
  highestTrainingLevel TrainingLevel

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique

  // I. Respondent Information
  /// Ethnicity, same option set and same two-slot rule as `Learner`. Nullable
  /// because every profile completed before the question existed has none.
  ethnicity               Ethnicity?
  /// Free text only when ethnicity = OTHER.
  ethnicityOther          String?
  /// Second ethnicity — see the note on `Learner.secondaryEthnicity`.
  secondaryEthnicity      Ethnicity?
  /// Free text only when secondaryEthnicity = OTHER.
  secondaryEthnicityOther String?
  contactNumber           String?
  /// Survey contact email (DOCX P-I4). Distinct from User.email login/synthetic identity.
  contactEmail            String?
  designation             String?
  /// DEFAULT = one advisory · FLOATING = none (no class roster, no end-of-term
  /// reports; ARAL still open) · MULTI_GRADE = one to three, any grades.
  /// Chosen once by the teacher at profiling, then changed only by the School
  /// Head (`setTeacherAdvisorySetting`).
  advisoryMode            AdvisoryMode     @default(DEFAULT)
  position                TeacherPosition?
  /// DepEd plantilla or not. Nullable because every profile completed before this
  /// field existed never answered the question, and a default would make those
  /// rows claim an answer nobody gave.
  ///
  /// DISPLAY ONLY. It is shown as a chip when designating an ARAL tutor so the
  /// person choosing can see who they are picking. It must never narrow the list
  /// of eligible tutors — a non-DepEd teacher is a valid ARAL tutor, which is the
  /// whole reason the field exists.
  employmentType          EmploymentType?

  // II. Professional Background
  educationalAttainment  EducationalAttainment
  fieldOfSpecialization  Specialization
  specializationOther    String?
  /// Years in service (0–70 inclusive). Null = N/A (teacher declined to specify).
  yearsInService         Int?
  currentGradeAssignment GradeLevelType?

  // III. Teaching Assignment
  /// Unused by the app going forward (removed from UI); kept nullable rather than
  /// dropped per "additive first" — drop in a future wave once explicitly approved.
  mostSubjectHandled Subject?

  // IV. Training & Professional Development
  hasReadingTraining   Boolean
  readingTrainings     ReadingTraining[]
  hasEnglishTraining   Boolean
  englishTrainings     EnglishTraining[]
  highestTrainingLevel TrainingLevel

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherInvite {
  id             String    @id @default(uuid())
  schoolId       String
  email          String? // optional — DOCX flow may add teachers by full name only
  firstName      String
  middleName     String?
  lastName       String
  userId         String? // teacher User created at invite time
  gradeLevelId   String?
  sectionId      String?
  tokenHash      String    @unique
  credentialHash String? // SHA-256 of one-time activation credential
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?       @relation("TeacherInviteUser", fields: [userId], references: [id], onDelete: SetNull)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([schoolId, email])
  @@index([userId])
  @@index([expiresAt])
}

model GradeLevel {
  id        String         @id @default(uuid())
  schoolId  String
  type      GradeLevelType
  createdAt DateTime       @default(now())
  deletedAt DateTime?

  school         School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers       User[]              @relation("TeacherGrades")
  learners       Learner[]
  sections       Section[]
  enrollments    Enrollment[]
  teacherInvites TeacherInvite[]
  attendanceDays AttendanceDayMeta[]

  @@unique([schoolId, type])
  @@index([deletedAt])
}

model Section {
  id           String    @id @default(uuid())
  schoolId     String
  gradeLevelId String
  name         String
  /// The teacher who advises this section, authoritative since Wave A of the
  /// multi-advisory change.
  ///
  /// Deliberately NOT `@unique`. One adviser per section is guaranteed by the
  /// column itself — a Section row holds one value — and a unique index here
  /// would mean the opposite thing: no two sections could name the same
  /// teacher, which is precisely the one-section-per-teacher limit this change
  /// exists to remove. The cap of three lives in `setTeacherAdvisory`.
  adviserId    String?
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  school         School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel     GradeLevel       @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  adviser        User?            @relation("SectionAdviser", fields: [adviserId], references: [id], onDelete: SetNull)
  teachers       TeacherSection[]
  learners       Learner[]
  enrollments    Enrollment[]
  teacherInvites TeacherInvite[]

  /// One name per grade, case-insensitively and among live sections only, via
  /// the SQL-only partial functional index `Section_gradeLevelId_name_folded_key`.
  /// Archived rows are excluded so `createSection` can revive one instead of
  /// being blocked by it. Preserve it when editing Section migrations.
  @@index([schoolId, deletedAt])
  /// "Which sections does this teacher advise?" is now the hot question — every
  /// scope predicate resolves a teacher's grades through it.
  @@index([adviserId])
}

/// Explicit M2M: which sections a teacher is assigned to teach.
/// Dual-written with `User.taughtGrades` during the Grade→Section migration.
model TeacherSection {
  teacherId  String
  sectionId  String
  assignedAt DateTime @default(now())

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([teacherId, sectionId])
  @@index([sectionId])
}

model Enrollment {
  id           String           @id @default(uuid())
  learnerId    String
  schoolId     String
  schoolYearId String
  gradeLevelId String
  sectionId    String?
  teacherId    String?
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  endedAt      DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  section    Section?   @relation(fields: [sectionId], references: [id])
  teacher    User?      @relation("TeacherEnrollments", fields: [teacherId], references: [id])

  @@index([learnerId, status])
  @@index([schoolId, schoolYearId])
  @@index([teacherId])
  @@index([gradeLevelId, sectionId])
  /// R6 #4. `deleteSection` runs `enrollment.updateMany({ where: { sectionId } })`;
  /// `[gradeLevelId, sectionId]` cannot serve it because `sectionId` is not leading.
  /// It is also the lookup side of this FK's `SetNull` action, though that is a
  /// schema-level property only: sections are soft-deleted today, so no
  /// referential action actually fires. The `updateMany` above is the real consumer.
  @@index([sectionId])
  /// R6 #5. `[schoolId, schoolYearId]` does not lead with `schoolYearId`.
  ///
  /// NOTE (fix round 1): this is the one index of the twelve with **no consumer in
  /// `src/` today**. Every Enrollment read keys on `learnerId` or `sectionId`; the
  /// one place pairing `schoolYearId` with `learnerId` and `status` is already
  /// served by `[learnerId, status]`; no raw SQL targets `"Enrollment"`; and every
  /// other appearance of `schoolYearId` is Enrollment *write* data, not a `where`.
  /// It covers the implicit `Restrict` probe when a `SchoolYear` row is hard-removed
  /// — and no `schoolYear.delete` exists in `src/` either, so that probe never fires
  /// from app code. Kept deliberately as forward cover. If a future index audit is
  /// looking for something to reclaim, start here, and re-check those five things
  /// rather than redoing the search.
  @@index([schoolYearId])
}

model Learner {
  id            String  @id @default(uuid())
  schoolId      String
  gradeLevelId  String
  /// Adviser. Null for a floating learner (no advisory section yet).
  teacherId     String?
  sectionId     String?
  /// ARAL designation, independent of the advisory axis. May point at a teacher
  /// with no advisory section.
  aralTeacherId String?

  // Section A - Initial Profile
  firstName  String
  middleName String?
  lastName   String
  fullName   String
  age        Int
  gender     Gender

  // Nullable: learners rostered before nutritional status was collected have
  // none. Required on create/update in Zod, not in the database.
  nutritionalStatus NutritionalStatus?

  // Nullable: learners rostered before ethnicity was collected have none.
  ethnicity               Ethnicity?
  // Free text only when ethnicity = OTHER.
  ethnicityOther          String?
  /// Second ethnicity, for someone of mixed heritage. Optional, and only
  /// meaningful when `ethnicity` is set — the form offers it behind an
  /// "Add another" button and refuses to repeat the first value.
  ///
  /// Two named columns rather than an `Ethnicity[]`: the cap really is two, and
  /// an array would make every existing read, CSV column and report rewrite
  /// itself to say the same thing.
  secondaryEthnicity      Ethnicity?
  /// Free text only when secondaryEthnicity = OTHER.
  secondaryEthnicityOther String?

  englishReadingProfile       ReadingProfile
  englishFrustrationSubtypes  FrustrationSubtype[]
  filipinoReadingProfile      ReadingProfile
  filipinoFrustrationSubtypes FrustrationSubtype[]

  governmentBenefits GovernmentBenefit[]
  parentEducation    ParentEducation

  // Section B - Attendance & School Background
  modeOfTransportation ModeOfTransportation?
  distanceHomeToSchool DistanceToSchool?
  previousTransfers    SchoolTransfers?
  transferDetails      String?

  // ARAL flag
  isAralLearner  Boolean   @default(false)
  aralEnrolledAt DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime? // archive is distinct from soft-delete deletedAt

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel    GradeLevel           @relation(fields: [gradeLevelId], references: [id])
  teacher       User?                @relation("TeacherLearners", fields: [teacherId], references: [id], onDelete: Restrict)
  aralTeacher   User?                @relation("AralTeacherLearners", fields: [aralTeacherId], references: [id], onDelete: SetNull)
  section       Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  aralProfile   AralProfile?
  attendances   Attendance[]
  readingLevels ReadingLevelRecord[]
  termGrades    TermGrade[]

  @@index([schoolId, gradeLevelId, isAralLearner, deletedAt])
  @@index([teacherId])
  @@index([aralTeacherId])
  @@index([schoolId, aralTeacherId, isAralLearner, deletedAt])
  /// R6 #2. Grade-scoped ARAL listings ordered by name. The consumer set is OPEN —
  /// the ARAL grade-scoped listings, including but not limited to the sites below.
  /// `isAralLearner` is a plain equality at every site below, and so is
  /// `gradeLevelId` on three of the four: the `[gradeId]` grid paths take it from
  /// the route segment, `resolveGradeLearnerWhere` from an action argument. Of the
  /// four, only `aral/page.tsx` can also send it as `IN (…)` (see that bullet).
  /// What varies is how much of the key a site can use, never which order it
  /// wants: `IN (…)` still filters on the leading column but stops delivering
  /// `fullName` globally ordered, so those calls pay for a sort that the equality
  /// paths do not. **This column order is the right one for all of them.**
  /// - `aral/[gradeId]/reading-level/page.tsx` — `count` plus `findMany` with
  ///   `orderBy fullName` AND `skip`/`take`. The ordered scan is worth most here,
  ///   because pagination is what pays for an unindexed sort.
  /// - `aral/page.tsx` (`aralWhere`) — reaches two of `gradeLevelIdWhere`'s three
  ///   return shapes (`src/lib/learners/pagination.ts`): a plain `{ gradeLevelId }`
  ///   when `?grade=` names an assigned grade, which is this index's exact shape and
  ///   also paginates, else `{ gradeLevelId: { in: [...] } }`. It passes
  ///   `activeGrade`, which normalises anything that is not an assigned grade id to
  ///   `"all"`, so the third shape is unreachable from this page. The same page's
  ///   enroll-candidate query pairs `gradeLevelId` with `isAralLearner: false`.
  /// - `aral/[gradeId]/attendance/page.tsx` (`learnerWhere`, then
  ///   `orderBy: { fullName: "asc" }`).
  /// - `resolveGradeLearnerWhere` in `src/lib/actions/aral-grid.ts` — used only as a
  ///   nested `learner:` relation filter, never with an `orderBy` on `Learner`, so
  ///   it uses the equality prefix and not the sort delivery.
  ///
  /// The page paths above are under `src/app/teacher/(app)/`. Do not read the list
  /// as exhaustive: if a future audit finds these paths refactored, re-derive the
  /// set before reclaiming the index — two of the four paginate off it.
  ///
  /// Do NOT drop `isAralLearner` from this key to serve the teacher learners list
  /// (`learnerListWhere`): on its default path that list sends `gradeLevelId` as
  /// `IN (…)` and omits `isAralLearner`, so it needs a *separate* index, not a
  /// reordering of this one. (With `?grade=<assigned id>&aralStatus=enrolled` that
  /// list does produce this index's exact shape and is served fully. The param is
  /// `aralStatus`, read at `src/lib/learners/pagination.ts`; there is no `aral`
  /// search param, and an unrecognised key would silently fall back to "all".)
  /// Removing `isAralLearner` here would widen every ARAL grid's scan from this
  /// grade's ARAL learners to its entire non-archived roster.
  /// `gradeLevelIdWhere`'s third shape (the `FLOATING` one) is unreachable from
  /// both callers today: each normalises `grade` against assigned grade ids first,
  /// and no grade id is `"floating"`, so that separate index can ignore it.
  ///
  /// Distinct from #6 below: this one leads with `gradeLevelId`, which the teacher
  /// learners list needs because it is tenant-scoped transitively through the
  /// teacher's assigned grade ids and carries no `schoolId` predicate to lead with.
  @@index([gradeLevelId, isAralLearner, fullName])
  /// R6 #4. `deleteSection` runs `learner.updateMany({ where: { sectionId } })`,
  /// an otherwise unindexed full-table scan inside a transaction. It is also the
  /// lookup side of this FK's `SetNull` action, though that is a schema-level
  /// property only: sections are soft-deleted today, so no referential action
  /// actually fires. The `updateMany` is the real consumer.
  @@index([sectionId])
  /// R6 #6. School-scoped name-ordered listings and the learner search `ILIKE`,
  /// which no b-tree can serve directly — this reduces it to one school's rows in
  /// name order. NOT redundant with #2: same trailing sort column, different lead
  /// column, so neither subsumes the other. Do not consolidate them.
  @@index([schoolId, fullName])
  /// The global `/admin/archive` read: `deletedAt IS NOT NULL ORDER BY deletedAt
  /// DESC`, cross-tenant and uncached. None of the composites above can serve it
  /// — every one of them leads with `schoolId` or `gradeLevelId`, which that
  /// query does not supply, so it was a seq scan plus an external sort.
  /// Deliberately a plain index, not a partial `WHERE "deletedAt" IS NOT NULL`:
  /// Prisma cannot express a partial index, and a fourth SQL-only object drifting
  /// from this file costs more than the megabytes it would save.
  @@index([deletedAt])
}

model Announcement {
  id          String    @id @default(uuid())
  schoolId    String
  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule. An
  /// announcement outlives its author: the school still needs to read it.
  authorId    String?
  title       String
  body        String
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([schoolId, publishedAt])
  @@index([deletedAt])
  /// R6 #5. FK lookup side — now the side `SetNull` scans on a `User` delete.
  @@index([authorId])
}

model AralProfile {
  id        String @id @default(uuid())
  learnerId String @unique

  // C. Reading Behavior
  absenteeismFrequency      AbsenteeismFrequency
  absenteeismOtherReason    String?
  /// Multi-select. Profiles written before this existed read back as [].
  absenteeismReasons        AbsenteeismReason[]
  letterRecognition         LetterRecognition
  letterSoundCorrespondence LetterSoundCorrespondence
  wordRecognition           WordRecognition

  // D. External Factors
  homeLiteracyEnvironment HomeLiteracyEnvironment
  parentalSupport         ParentalSupport
  classroomEnvironment    ClassroomEnvironment
  languageConsiderations  LanguageConsideration[]

  // E. Interventions & Recommendations
  suggestedInterventions Intervention[]
  lsenObservations       String?
  furtherAssessment      FurtherAssessment[]
  furtherAssessmentOther String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String           @id @default(uuid())
  learnerId    String
  date         DateTime         @db.Date
  weekStart    DateTime         @db.Date // Monday of that week, for aggregation
  status       AttendanceStatus
  notes        String?
  /// NULLABLE, `ON DELETE SET NULL` — the canonical instance of the attribution
  /// rule that also governs `AttendanceDayMeta.recordedById`,
  /// `ReadingLevelRecord.recordedById`, `TermGrade.recordedById`,
  /// `Announcement.authorId`, `Report.createdById`, `UnlockGrant.grantedById`,
  /// `SchoolUnlockGrant.grantedById` and `TermWindowOverride.setById`.
  ///
  /// These nine were `ON DELETE RESTRICT`, which made a permanent delete of any
  /// teacher who had ever recorded anything impossible at the storage layer. The
  /// project owner's decision is that a permanent delete must ALWAYS succeed, so
  /// the row survives the person and loses only its "who recorded this" pointer.
  ///
  /// The cost is real and accepted: a purged teacher's attendance marks, reading
  /// assessments and term grades keep existing but can no longer name who took
  /// them. Read sites must treat NULL as "recorder no longer exists", not as an
  /// error. NULL here NEVER means "not yet recorded" — the row's existence is
  /// what records the event.
  recordedById String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([learnerId, date])
  @@index([learnerId, weekStart])
  @@index([date])
  /// R6 #3. FK lookup side — now the side `SetNull` scans on a `User` delete,
  /// which makes it load-bearing for the purge, not only for the old `Restrict`.
  @@index([recordedById])
}

/// Grade-level day metadata (e.g. holiday) for ARAL attendance grids.
model AttendanceDayMeta {
  id           String   @id @default(uuid())
  gradeLevelId String
  date         DateTime @db.Date
  isHoliday    Boolean  @default(false)
  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule.
  recordedById String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("AttendanceDayRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([gradeLevelId, date])
  @@index([date])
  /// R6 #5. FK lookup side — now the side `SetNull` scans on a `User` delete.
  @@index([recordedById])
}

model ReadingLevelRecord {
  id                        String                           @id @default(uuid())
  learnerId                 String
  weekStart                 DateTime                         @db.Date // Anchor of the recorded assessment period. The live monthly writer stores the 1st of the month; older rows from the retired weekly grid hold a Monday.
  /// Nullable: a partial monthly assessment (only one language scored so far)
  /// is a legitimate row, not an error. Whether a row counts as COMPLETE for a
  /// given month is a predicate, not a schema constraint — it lives in
  /// `src/lib/aral/reading-level-progress.ts`, not here.
  englishProfile            ReadingProfile?
  /// See `englishProfile` — same nullability, same reason, same completeness
  /// predicate in `src/lib/aral/reading-level-progress.ts`.
  filipinoProfile           ReadingProfile?
  wordRecognitionLevel      WeeklyWordRecognitionLevel?
  readingComprehensionLevel WeeklyReadingComprehensionLevel?
  writingLevel              WeeklyWritingLevel?
  notes                     String?
  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule.
  /// Distinct from the two nullable profile columns above: those are nullable
  /// because a partial assessment is legitimate, this one because the recorder
  /// can be permanently deleted after the fact.
  recordedById              String?
  createdAt                 DateTime                         @default(now())
  updatedAt                 DateTime                         @updatedAt

  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  recordedBy User?   @relation("ReadingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([learnerId, weekStart])
  @@index([weekStart])
  /// R6 #3. FK lookup side — now the side `SetNull` scans on a `User` delete.
  @@index([recordedById])
}

/// One learner's grade in one learning area for one term of one school year.
/// Corrected by overwrite, never soft-deleted - hence no `deletedAt`.
model TermGrade {
  id           String       @id @default(uuid())
  learnerId    String
  schoolYearId String
  term         TermPeriod
  subject      LearningArea
  score        Int // 60-100, enforced by a CHECK constraint in SQL
  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule.
  recordedById String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  recordedBy User?      @relation("TermGradeRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  @@unique([learnerId, schoolYearId, term, subject])
  @@index([schoolYearId, term])
  /// R6 #5. FK lookup side — now the side `SetNull` scans on a `User` delete.
  @@index([recordedById])
}

/// An in-app message addressed to one user, with its own read state.
///
/// The shell bell previously rendered values DERIVED from dashboard numbers, which
/// cannot carry "who did this to me" or "I have seen it". Both are required for an
/// ARAL designation, so designations get a row.
model Notification {
  id                  String           @id @default(uuid())
  schoolId            String
  recipientId         String
  /// Who caused it. Nullable so removing an account leaves the notification
  /// readable rather than deleting the recipient's history with it.
  actorId             String?
  type                NotificationType
  /// Learner ids this notification is about. Ids only: the sentence the recipient
  /// reads is composed at read time from the current learner rows, so no learner
  /// PII is duplicated into this table and a renamed or removed learner cannot
  /// leave stale text in the feed.
  ///
  /// One row per action, not per learner — enrolling twelve learners at once
  /// notifies the tutor once.
  learnerIds          String[]
  /// Set on the `SUPPORT_TICKET_*` types instead of `learnerIds`, which is
  /// learner-specific by design. `SetNull` so deleting a ticket leaves the
  /// notification readable.
  ticketId            String?
  /// Set on the `CHAT_*` types. `SetNull` so deleting a channel leaves the
  /// notification readable rather than removing the recipient's history.
  channelId           String?
  /// The personal `UnlockGrant` this notification is about, when the unlock
  /// was issued to this recipient specifically. Mutually exclusive with
  /// `schoolUnlockGrantId` — see the CHECK constraint below, which is
  /// SQL-only: Prisma's schema language cannot express it, the same
  /// situation as `Enrollment`'s one-ACTIVE-row-per-learner index. Preserve
  /// it when editing this table's migrations.
  unlockGrantId       String?
  /// The `SchoolUnlockGrant` this notification is about, when the unlock
  /// covered every teacher in the school. Mutually exclusive with
  /// `unlockGrantId` — see the note above.
  schoolUnlockGrantId String?
  readAt              DateTime?
  createdAt           DateTime         @default(now())

  school            School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  recipient         User               @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  actor             User?              @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  ticket            SupportTicket?     @relation("NotificationTicket", fields: [ticketId], references: [id], onDelete: SetNull)
  channel           ChatChannel?       @relation("NotificationChatChannel", fields: [channelId], references: [id], onDelete: SetNull)
  unlockGrant       UnlockGrant?       @relation("NotificationUnlockGrant", fields: [unlockGrantId], references: [id], onDelete: SetNull)
  schoolUnlockGrant SchoolUnlockGrant? @relation("NotificationSchoolUnlockGrant", fields: [schoolUnlockGrantId], references: [id], onDelete: SetNull)

  /// The feed read: this recipient's unread rows, newest first.
  @@index([recipientId, readAt, createdAt])
  @@index([schoolId, createdAt])
  /// R6 #5. Lookup side of this FK's `SetNull` action — removing an account must
  /// find every notification it caused and null the pointer.
  @@index([actorId])
  /// Same rule for the ticket pointer's `SetNull`.
  @@index([ticketId])
  /// Same rule for each unlock pointer's `SetNull`.
  @@index([unlockGrantId])
  @@index([schoolUnlockGrantId])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  schoolId   String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([schoolId, timestamp])
  @@index([resource, resourceId])
  /// R6 #1. The Super Admin audit view is a deliberately cross-tenant top-N
  /// (`orderBy timestamp desc, take 150`, no `where`), and the dashboard's
  /// `timestamp >= $1` range scan uses the same index. Neither is served by the
  /// composites above, which all lead with a different column. Ascending on
  /// purpose: PostgreSQL scans a b-tree backwards at equal cost, so a `sort: Desc`
  /// modifier would buy nothing and would change the generated index definition.
  @@index([timestamp])
}

/// What a generated report covers. Mirrors the cards on the Reports Hub, and is
/// what the Recent Reports table groups and re-generates by.
enum ReportKind {
  ATTENDANCE
  READING_LEVEL
  TERM_GRADES
  TEACHER_SUMMARY
  CLASS_ROSTER
  CUSTOM
}

enum ReportFormat {
  EXCEL
  PDF
}

/// One generated report, kept so the Reports Hub can list history.
///
/// The FILE is deliberately not stored: it is regenerated from `filters` on
/// demand, so nothing here holds learner PII at rest and there is no blob store
/// to keep in step with a learner who is later archived or transferred.
/// `name` and `scopeLabel` are denormalised for exactly that reason — a section
/// renamed or soft-deleted after the fact must not blank out a history row.
model Report {
  id          String       @id @default(uuid())
  schoolId    String
  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule. A
  /// history row whose author was purged still lists and still re-generates:
  /// everything it needs is in `filters`.
  createdById String?
  kind        ReportKind
  format      ReportFormat
  /// Shown verbatim in the Recent Reports table.
  name        String
  /// "Grade 5 - Section A", "All Classes" — the row's Grade / Section cell.
  scopeLabel  String?
  /// The filter set this report was generated with, replayed by Re-generate.
  filters     Json
  createdAt   DateTime     @default(now())
  deletedAt   DateTime?

  school    School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  createdBy User?  @relation("ReportCreator", fields: [createdById], references: [id], onDelete: SetNull)

  /// The Recent Reports query: one school, one author, newest first.
  @@index([schoolId, createdById, createdAt])
  /// FK lookup side — now the side `SetNull` scans on a `User` delete, matching
  /// the R6 #3/#5 rule.
  @@index([createdById])
}

// ─────────────────────────────────────────────────────────────────────────────
// Support assistant: tickets to the division admin, and the unlock grants a
// resolved ticket can produce.
// ─────────────────────────────────────────────────────────────────────────────

/// What a ticket is asking for. `UNLOCK_REQUEST` is the only category that may
/// carry `requestedScope` / `requestedTargetKey` and the only one an admin can
/// resolve by issuing an `UnlockGrant`.
enum SupportTicketCategory {
  UNLOCK_REQUEST
  SYSTEM_ASSISTANCE
  BUG_REPORT
  ACCOUNT_ACCESS
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  DECLINED
}

/// The editing windows a grant can reopen. One value per enforced lock in the
/// app — adding a value here without adding its check at the lock site produces
/// a grant that silently does nothing, so the two must move together.
///
/// `ARAL_WEEKLY_ATTENDANCE` is enforced in `saveAralWeeklyAttendance`
/// (`src/lib/actions/attendance.ts`); `TERM_GRADES` in `saveTermGrades`
/// (`src/lib/actions/term-grades.ts`).
enum UnlockScope {
  ARAL_WEEKLY_ATTENDANCE
  TERM_GRADES
  /// `targetKey` is a month anchor `YYYY-MM-01`, matching
  /// `ReadingLevelRecord.weekStart`'s monthly convention. Lock site:
  /// `bulkRecordMonthlyReadingLevel` in `src/lib/actions/reading-level.ts`.
  MONTHLY_READING_LEVEL
}

/// One request for help raised from the floating assistant.
///
/// `subject` and `body` are free text typed by a teacher or school head. They are
/// rendered as escaped plain text and are NEVER copied into `AuditLog.metadata`:
/// a person describing a problem with their class will name learners, and audit
/// metadata is the one place that must stay free of learner PII.
model SupportTicket {
  id          String                @id @default(uuid())
  schoolId    String
  requesterId String
  category    SupportTicketCategory
  status      SupportTicketStatus   @default(OPEN)
  subject     String
  body        String
  /// Pathname the assistant was opened from, e.g. `/teacher/aral/<id>/attendance`.
  /// A path only — never a full URL with a query string, which could carry ids.
  pageUrl     String?

  /// Set only when `category = UNLOCK_REQUEST`. The pair says which window to
  /// reopen; `requestedTargetKey` is a Monday `YYYY-MM-DD` for
  /// `ARAL_WEEKLY_ATTENDANCE` and a `TermPeriod` name for `TERM_GRADES`.
  requestedScope     UnlockScope?
  requestedTargetKey String?

  /// Resolution. `resolutionNote` is the single reply a requester gets — this is
  /// deliberately not a threaded conversation.
  resolverId     String?
  resolutionNote String?
  resolvedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  requester     User           @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// Nullable + `SetNull` so removing an admin account leaves the ticket's
  /// history readable rather than deleting it.
  resolver      User?          @relation("SupportTicketResolver", fields: [resolverId], references: [id], onDelete: SetNull)
  grant         UnlockGrant?
  notifications Notification[] @relation("NotificationTicket")

  /// The admin inbox read: open tickets first, newest first.
  @@index([status, createdAt])
  /// One school's tickets — the school-scoped list a requester sees.
  @@index([schoolId, createdAt])
  /// "My requests" in the assistant panel.
  @@index([requesterId, createdAt])
  /// R6 #5. Lookup side of this FK's `SetNull` action.
  @@index([resolverId])
}

/// Permission for one user to write inside one already-closed editing window.
///
/// Deliberately narrow: a grant names a single user, a single scope and a single
/// target period, and it expires. There is no school-wide or open-ended form,
/// because the failure mode of this table is a lock left quietly open.
///
/// The lock sites treat any error resolving a grant as "no grant" — the window
/// stays closed. A grant only ever widens access, never narrows it.
model UnlockGrant {
  id        String      @id @default(uuid())
  schoolId  String
  /// Who may now write. Not the school — see the model comment.
  userId    String
  scope     UnlockScope
  /// Monday `YYYY-MM-DD` for `ARAL_WEEKLY_ATTENDANCE`, a `TermPeriod` name for
  /// `TERM_GRADES`. A bare string rather than two nullable typed columns because
  /// the lock sites already key their windows by exactly these strings.
  targetKey String

  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule. NULL
  /// here means "the admin who issued this has since been permanently deleted",
  /// never "granted by nobody"; the grant itself is unaffected and still expires
  /// on its own terms.
  grantedById String?
  /// The ticket this grant answers, when it came from one. Nullable so an admin
  /// can also grant directly. `@unique` keeps one ticket from issuing two grants.
  ticketId    String? @unique

  /// Required. A grant that never expires is a lock that was removed, not reopened.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user          User           @relation("UnlockGrantUser", fields: [userId], references: [id], onDelete: Cascade)
  grantedBy     User?          @relation("UnlockGrantGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy     User?          @relation("UnlockGrantRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  ticket        SupportTicket? @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  notifications Notification[] @relation("NotificationUnlockGrant")

  /// One grant row per window per person. A re-grant updates this row rather
  /// than stacking a second one, so "is it open?" never depends on row order.
  @@unique([userId, scope, targetKey])
  /// The hot read, on every save into a closed window: this user, this scope,
  /// still in date.
  @@index([userId, scope, expiresAt])
  /// The admin list of live grants for one school.
  @@index([schoolId, expiresAt])
  /// R6 #3/#5. FK lookup sides.
  @@index([grantedById])
  @@index([revokedById])
}

/// One unlock covering every teacher in a school for one window, rather than
/// one person.
///
/// A DEDICATED TABLE, not a nullable `UnlockGrant.userId`. In Postgres two
/// NULLs are never equal, so `@@unique([userId, scope, targetKey])` treats
/// every NULL-userId row as distinct from every other one — a school-wide
/// grant modeled that way would silently defeat the unique and let a second,
/// third, or Nth live school-wide grant for the same window exist alongside
/// the first, making "is it open?" depend on row order rather than on a
/// single row of truth. Keeping the school-wide case in its own table, with
/// its own all-NOT-NULL `(schoolId, scope, targetKey)` unique, avoids the
/// NULL-collapse problem entirely instead of working around it.
model SchoolUnlockGrant {
  id        String      @id @default(uuid())
  schoolId  String
  scope     UnlockScope
  /// Same convention as `UnlockGrant.targetKey` — a Monday `YYYY-MM-DD` for
  /// `ARAL_WEEKLY_ATTENDANCE`, a `TermPeriod` name for `TERM_GRADES`, a month
  /// anchor `YYYY-MM-01` for `MONTHLY_READING_LEVEL`.
  targetKey String

  /// Nullable, `SetNull` — see `Attendance.recordedById` for the full rule. This
  /// one previously carried an EXPLICIT `onDelete: Restrict`, the only one of the
  /// nine that did; it is now `SetNull` like the rest.
  grantedById String?

  /// Required. A grant that never expires is a lock that was removed, not
  /// reopened — same rule as `UnlockGrant.expiresAt`.
  expiresAt   DateTime
  revokedAt   DateTime?
  revokedById String?

  createdAt DateTime @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grantedBy     User?          @relation("SchoolUnlockGrantGranter", fields: [grantedById], references: [id], onDelete: SetNull)
  revokedBy     User?          @relation("SchoolUnlockGrantRevoker", fields: [revokedById], references: [id], onDelete: SetNull)
  notifications Notification[] @relation("NotificationSchoolUnlockGrant")

  /// One grant row per window per school. Same reasoning as `UnlockGrant`'s
  /// own unique: a re-grant updates this row rather than stacking a second
  /// one, so "is it open?" never depends on row order.
  @@unique([schoolId, scope, targetKey])
  /// The hot read, on every save into a closed window: this school, this
  /// scope, still in date.
  @@index([schoolId, scope, expiresAt])
  /// R6. FK lookup sides.
  @@index([grantedById])
  @@index([revokedById])
}

/// Who a chat channel is between.
///
/// `SCHOOL` is the staff room: every active member of one school, plus any
/// division admin who visits. `ADMIN_DIRECT` is one member's private line to the
/// admin team — not to a named admin, because there are several and any of them
/// should be able to answer. Which one did is visible from the message's author.
enum ChatChannelKind {
  SCHOOL
  ADMIN_DIRECT
}

/// A conversation. One `SCHOOL` row per school and one `ADMIN_DIRECT` row per
/// member, both enforced by partial unique indexes in SQL — Prisma's schema
/// language cannot express a uniqueness that applies to only some rows, and
/// without them a double-submit creates a second channel and splits a
/// conversation in half. See the migration.
model ChatChannel {
  id       String          @id @default(uuid())
  schoolId String
  kind     ChatChannelKind
  /// `ADMIN_DIRECT` only: the school-side person who owns the thread. Null on a
  /// `SCHOOL` row, which belongs to everyone in the school.
  memberId String?

  /// Denormalised from the newest message, so the channel list can order and
  /// preview without loading messages. Written in the same transaction as the
  /// message it describes.
  lastMessageAt DateTime?
  createdAt     DateTime  @default(now())

  school        School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  member        User?          @relation("ChatChannelMember", fields: [memberId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]
  reads         ChatRead[]
  notifications Notification[] @relation("NotificationChatChannel")

  /// The channel list: a school's threads, most recently active first.
  @@index([schoolId, kind, lastMessageAt])
  @@index([memberId])
}

/// One message. Soft-deleted like everything else here, so a removed message
/// leaves the thread readable rather than renumbering it.
model ChatMessage {
  id        String    @id @default(uuid())
  channelId String
  authorId  String
  body      String
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  channel  ChatChannel   @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author   User          @relation("ChatMessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  mentions ChatMention[]

  /// The transcript read: one channel, oldest to newest.
  @@index([channelId, createdAt])
  @@index([authorId])
}

/// A resolved @mention. Stored rather than re-parsed on read: the body keeps the
/// text the author typed, and a renamed or deactivated account must not silently
/// stop being mentioned in a message that already named them.
model ChatMention {
  id        String @id @default(uuid())
  messageId String
  userId    String

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation("ChatMentionUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

/// How far one person has read one channel.
///
/// A timestamp rather than a per-message row: unread is "newer than this", which
/// is one comparison and does not grow with the transcript.
model ChatRead {
  channelId  String
  userId     String
  lastReadAt DateTime @default(now())

  channel ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user    User        @relation("ChatReadUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([channelId, userId])
  @@index([userId])
}

/// One server-side failure worth an admin's attention: a `security` refusal or a
/// `system` failure. Written by `src/lib/errors/report.ts`, read only by the
/// Super Admin page `/admin/errors`.
///
/// Deliberately unrelated to User/School (plain id columns, no FKs): a failure
/// must be recordable while the rows it concerns are broken or gone, and a
/// deleted school must not cascade its error history away before retention does.
/// `ref` is not unique: a Next.js digest repeats for the same underlying error,
/// and searching one should show every occurrence. Purged after
/// ERROR_EVENT_RETENTION_DAYS (default 30) by the daily cron.
model ErrorEvent {
  id        String   @id @default(uuid())
  ref       String
  code      String
  severity  String
  message   String
  stack     String?
  route     String?
  routeType String?
  method    String?
  userId    String?
  schoolId  String?
  context   Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([ref])
  @@index([code, createdAt])
  @@index([schoolId, createdAt])
}
