// PROJECT LITRACK - Prisma Schema
// Datasource: Supabase Postgres

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =====================================================
// ENUMS
// =====================================================

enum UserRole {
  SUPER_ADMIN
  SCHOOL_HEAD
  TEACHER
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum GradeLevelType {
  KINDER
  G1
  G2
  G3
  G4
  G5
  G6
  G7
  G8
  G9
  G10
  G11
  G12
  FLOATING
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum ReadingProfile {
  NON_DECODER_LOW_EMERGENT
  FRUSTRATION_HIGH_EMERGENT
  INSTRUCTIONAL_DEVELOPING
  INDEPENDENT_GRADE_READY
}

enum FrustrationSubtype {
  DECODING
  COMPREHENSION_ALL
  COMPREHENSION_CRITICAL
}

enum EducationalAttainment {
  BACHELORS
  WITH_MASTERS_UNITS
  MASTERS
  WITH_DOCTORAL_UNITS
  DOCTORAL
}

enum TrainingLevel {
  INTERNATIONAL
  NATIONAL
  REGION
  DIVISION
  DISTRICT
  SCHOOL
  NA
}

enum SchoolHeadPosition {
  TEACHER_I_TIC
  TEACHER_II_TIC
  TEACHER_III_TIC
  TEACHER_IV_TIC
  TEACHER_V_TIC
  HEAD_TEACHER_I
  HEAD_TEACHER_II
  HEAD_TEACHER_III
  HEAD_TEACHER_IV
  HEAD_TEACHER_V
  HEAD_TEACHER_VI
  HEAD_TEACHER_VII
  PRINCIPAL_I
  PRINCIPAL_II
  PRINCIPAL_III
  PRINCIPAL_IV
  TECHVOC_AD
}

enum TeacherPosition {
  TEACHER_I
  TEACHER_II
  TEACHER_III
  TEACHER_IV
  TEACHER_V
  TEACHER_VI
  TEACHER_VII
  MASTER_TEACHER_I
  MASTER_TEACHER_II
  MASTER_TEACHER_III
  MASTER_TEACHER_IV
}

enum Specialization {
  GENERAL_EDUCATION
  ENGLISH
  MATH
  SCIENCE
  FILIPINO
  TLE_EPP
  ARALPAN
  MAPEH
  TECHVOC
  VALUES_ED
  OTHERS
}

enum Subject {
  ENGLISH
  MATH
  SCIENCE
  FILIPINO
  TLE_EPP
  ARALPAN
  MAPEH
  TECHVOC
  VALUES_ED
  ABM
}

enum ReadingTraining {
  ARAL
  TEACHING_READING
  ELLN
  TEACEP
  NONE
}

enum EnglishTraining {
  MATATAG_TRAINING
  UPSKILLING_ENGLISH_COMPETENCE
  NONE
}

enum GovernmentBenefit {
  FOUR_PS
  IPS
}

enum ParentEducation {
  NO_FORMAL
  ELEMENTARY_LEVEL
  ELEMENTARY_GRADUATE
  SECONDARY_LEVEL
  SECONDARY_GRADUATE
  COLLEGE_LEVEL
  COLLEGE_GRADUATE
}

enum ModeOfTransportation {
  WALKING
  MOTORCYCLE
  BUS_JEEP_CAR
}

enum DistanceToSchool {
  LESS_THAN_1KM
  ONE_TO_FIVE_KM
  MORE_THAN_5KM
}

enum SchoolTransfers {
  NONE
  ONE
  MULTIPLE
}

enum AbsenteeismFrequency {
  ONE_TO_THREE_PER_MONTH
  THREE_TO_FIVE_PER_MONTH
  MORE_THAN_FIVE_PER_MONTH
  WEEKLY
  OTHER
}

enum LetterRecognition {
  ALL_EASY
  CONFUSES_SIMILAR
  STRUGGLES_RECALL
  NA
}

enum LetterSoundCorrespondence {
  ACCURATE
  INCONSISTENT
  UNABLE
  NA
}

enum WordRecognition {
  READS_HF_FLUENT
  GUESSES
  OMITS_ADDS_REPLACES
  STRUGGLES_SIGHT_WORDS
  NA
}

enum HomeLiteracyEnvironment {
  HAS_ACCESS
  LIMITED
  NONE
  NA
}

enum ParentalSupport {
  REGULAR
  LIMITED
  NONE
  NA
}

enum ClassroomEnvironment {
  SMALL_CLASS
  LARGE_CLASS
  NA
}

enum LanguageConsideration {
  MATCHES_LOI
  DIFFERENT_DIALECT
  STRUGGLES_TRANSITION
  NA
}

enum Intervention {
  PHONEMIC_AWARENESS
  LETTER_SOUND_DRILLS
  SIGHT_WORD_PRACTICE
  STRUCTURED_PHONICS
  ONE_ON_ONE
  HOME_READING
  LSEN_OTHER
}

enum FurtherAssessment {
  MFAT
  OTHER
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  TRANSFERRED
  ARCHIVED
}

// =====================================================
// MODELS
// =====================================================

model School {
  id           String   @id @default(uuid())
  name         String   @unique
  schoolIdCode String   @unique // password used for login
  address      String?
  region       String?
  division     String?
  district     String?
  isActive     Boolean  @default(true)
  createdById  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  deletedAt    DateTime?

  users          User[]
  gradeLevels    GradeLevel[]
  learners       Learner[]
  schoolYears    SchoolYear[]
  teacherInvites TeacherInvite[]
  sections       Section[]
  enrollments    Enrollment[]
  announcements  Announcement[]

  @@index([deletedAt])
  @@index([isActive])
}

model SchoolYear {
  id        String   @id @default(uuid())
  schoolId  String
  label     String   // e.g. "2025-2026"
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(false)
  createdAt DateTime @default(now())

  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments Enrollment[]

  @@unique([schoolId, label])
  @@index([schoolId, isActive])
}

model User {
  id         String   @id @default(uuid())
  authId     String   @unique // Supabase auth.users.id
  email      String   @unique
  role       UserRole
  schoolId   String?
  firstName  String
  middleName String?
  lastName   String
  fullName   String
  isActive   Boolean  @default(false)
  mustChangePassword Boolean @default(false)
  // Profile completion flags
  profileCompleted Boolean @default(false)
  // Teacher self-registration approval (null for non-teacher roles)
  approvalStatus TeacherApprovalStatus?
  approvedAt     DateTime?
  approvedById   String?
  rejectedAt     DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  deletedAt  DateTime?

  school                School?              @relation(fields: [schoolId], references: [id])
  schoolHeadProfile     SchoolHeadProfile?
  teacherProfile        TeacherProfile?
  taughtGrades          GradeLevel[]         @relation("TeacherGrades")
  taughtSections        TeacherSection[]
  managedLearners       Learner[]            @relation("TeacherLearners")
  recordedAttendance    Attendance[]         @relation("AttendanceRecorder")
  recordedReadingLevels ReadingLevelRecord[] @relation("ReadingRecorder")
  teacherEnrollments    Enrollment[]         @relation("TeacherEnrollments")
  announcements         Announcement[]
  teacherInvites        TeacherInvite[]      @relation("TeacherInviteUser")

  @@index([schoolId, role, deletedAt])
  @@index([schoolId, approvalStatus])
  @@index([authId])
}

model SchoolHeadProfile {
  id     String @id @default(uuid())
  userId String @unique

  // I. Respondent Information
  contactNumber String?
  /// Survey contact email (DOCX P-I4). Distinct from User.email login/synthetic identity.
  contactEmail  String?
  designation   String?
  position      SchoolHeadPosition

  // II. Professional Background
  educationalAttainment EducationalAttainment
  fieldOfSpecialization Specialization
  specializationOther   String?
  /// Years in service (0–70 inclusive).
  yearsInService        Int

  // IV. Training & Professional Development
  hasReadingTraining   Boolean
  readingTrainings     ReadingTraining[]
  hasEnglishTraining   Boolean
  englishTrainings     EnglishTraining[]
  highestTrainingLevel TrainingLevel

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherProfile {
  id     String @id @default(uuid())
  userId String @unique

  // I. Respondent Information
  contactNumber String?
  /// Survey contact email (DOCX P-I4). Distinct from User.email login/synthetic identity.
  contactEmail  String?
  designation   String?
  position      TeacherPosition?

  // II. Professional Background
  educationalAttainment   EducationalAttainment
  fieldOfSpecialization   Specialization
  specializationOther     String?
  /// Years in service (0–70 inclusive).
  yearsInService          Int
  currentGradeAssignment  GradeLevelType?

  // III. Teaching Assignment
  mostSubjectHandled Subject

  // IV. Training & Professional Development
  hasReadingTraining   Boolean
  readingTrainings     ReadingTraining[]
  hasEnglishTraining   Boolean
  englishTrainings     EnglishTraining[]
  highestTrainingLevel TrainingLevel

  completedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model TeacherInvite {
  id             String    @id @default(uuid())
  schoolId       String
  email          String? // optional — DOCX flow may add teachers by full name only
  firstName      String
  middleName     String?
  lastName       String
  userId         String? // teacher User created at invite time
  gradeLevelId   String?
  sectionId      String?
  tokenHash      String    @unique
  credentialHash String? // SHA-256 of one-time activation credential
  expiresAt      DateTime
  consumedAt     DateTime?
  revokedAt      DateTime?
  createdById    String?
  lastSentAt     DateTime?
  createdAt      DateTime  @default(now())

  school     School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user       User?       @relation("TeacherInviteUser", fields: [userId], references: [id], onDelete: SetNull)
  gradeLevel GradeLevel? @relation(fields: [gradeLevelId], references: [id], onDelete: SetNull)
  section    Section?    @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  @@index([schoolId, email])
  @@index([userId])
  @@index([expiresAt])
}

model GradeLevel {
  id        String         @id @default(uuid())
  schoolId  String
  type      GradeLevelType
  createdAt DateTime       @default(now())
  deletedAt DateTime?

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teachers       User[]          @relation("TeacherGrades")
  learners       Learner[]
  sections       Section[]
  enrollments    Enrollment[]
  teacherInvites TeacherInvite[]

  @@unique([schoolId, type])
  @@index([deletedAt])
}

model Section {
  id           String    @id @default(uuid())
  schoolId     String
  gradeLevelId String
  name         String
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  school         School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel     GradeLevel      @relation(fields: [gradeLevelId], references: [id], onDelete: Cascade)
  teachers       TeacherSection[]
  learners       Learner[]
  enrollments    Enrollment[]
  teacherInvites TeacherInvite[]

  @@unique([gradeLevelId, name])
  @@index([schoolId, deletedAt])
}

/// Explicit M2M: which sections a teacher is assigned to teach.
/// Dual-written with `User.taughtGrades` during the Grade→Section migration.
model TeacherSection {
  teacherId  String
  sectionId  String
  assignedAt DateTime @default(now())

  teacher User    @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  section Section @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@id([teacherId, sectionId])
  @@index([sectionId])
}

model Enrollment {
  id           String           @id @default(uuid())
  learnerId    String
  schoolId     String
  schoolYearId String
  gradeLevelId String
  sectionId    String?
  teacherId    String?
  status       EnrollmentStatus @default(ACTIVE)
  enrolledAt   DateTime         @default(now())
  endedAt      DateTime?
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  learner    Learner    @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  school     School     @relation(fields: [schoolId], references: [id])
  schoolYear SchoolYear @relation(fields: [schoolYearId], references: [id])
  gradeLevel GradeLevel @relation(fields: [gradeLevelId], references: [id])
  section    Section?   @relation(fields: [sectionId], references: [id])
  teacher    User?      @relation("TeacherEnrollments", fields: [teacherId], references: [id])

  @@index([learnerId, status])
  @@index([schoolId, schoolYearId])
  @@index([teacherId])
  @@index([gradeLevelId, sectionId])
}

model Learner {
  id           String  @id @default(uuid())
  schoolId     String
  gradeLevelId String
  teacherId    String
  sectionId    String?

  // Section A - Initial Profile
  firstName  String
  middleName String?
  lastName   String
  fullName   String
  age        Int
  gender     Gender

  englishReadingProfile        ReadingProfile
  englishFrustrationSubtypes   FrustrationSubtype[]
  filipinoReadingProfile       ReadingProfile
  filipinoFrustrationSubtypes  FrustrationSubtype[]

  governmentBenefits GovernmentBenefit[]
  parentEducation    ParentEducation

  // ARAL flag
  isAralLearner   Boolean   @default(false)
  aralEnrolledAt  DateTime?

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  archivedAt DateTime? // archive is distinct from soft-delete deletedAt

  school        School               @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  gradeLevel    GradeLevel           @relation(fields: [gradeLevelId], references: [id])
  teacher       User                 @relation("TeacherLearners", fields: [teacherId], references: [id])
  section       Section?             @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  enrollments   Enrollment[]
  aralProfile   AralProfile?
  attendances   Attendance[]
  readingLevels ReadingLevelRecord[]

  @@index([schoolId, gradeLevelId, isAralLearner, deletedAt])
  @@index([teacherId])
}

model Announcement {
  id          String    @id @default(uuid())
  schoolId    String
  authorId    String
  title       String
  body        String
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author User   @relation(fields: [authorId], references: [id])

  @@index([schoolId, publishedAt])
  @@index([deletedAt])
}

model AralProfile {
  id        String @id @default(uuid())
  learnerId String @unique

  // B. Attendance & School Background
  modeOfTransportation ModeOfTransportation
  distanceHomeToSchool DistanceToSchool
  previousTransfers    SchoolTransfers
  transferDetails      String?

  // C. Reading Behavior
  absenteeismFrequency      AbsenteeismFrequency
  absenteeismOtherReason    String?
  letterRecognition         LetterRecognition
  letterSoundCorrespondence LetterSoundCorrespondence
  wordRecognition           WordRecognition

  // D. External Factors
  homeLiteracyEnvironment HomeLiteracyEnvironment
  parentalSupport         ParentalSupport
  classroomEnvironment    ClassroomEnvironment
  languageConsiderations  LanguageConsideration[]

  // E. Interventions & Recommendations
  suggestedInterventions Intervention[]
  lsenObservations       String?
  furtherAssessment      FurtherAssessment[]
  furtherAssessmentOther String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  learner Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
}

model Attendance {
  id           String           @id @default(uuid())
  learnerId    String
  date         DateTime         @db.Date
  weekStart    DateTime         @db.Date // Monday of that week, for aggregation
  status       AttendanceStatus
  notes        String?
  recordedById String
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("AttendanceRecorder", fields: [recordedById], references: [id])

  @@unique([learnerId, date])
  @@index([learnerId, weekStart])
  @@index([date])
}

model ReadingLevelRecord {
  id              String         @id @default(uuid())
  learnerId       String
  monthYear       String         // "2026-05"
  englishProfile  ReadingProfile
  filipinoProfile ReadingProfile
  notes           String?
  recordedById    String
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  learner    Learner @relation(fields: [learnerId], references: [id], onDelete: Cascade)
  recordedBy User    @relation("ReadingRecorder", fields: [recordedById], references: [id])

  @@unique([learnerId, monthYear])
  @@index([monthYear])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  schoolId   String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  timestamp  DateTime @default(now())

  @@index([userId, timestamp])
  @@index([schoolId, timestamp])
  @@index([resource, resourceId])
}
